{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(pwd)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(nvidia-smi)",
      "Bash(conda info *)",
      "Bash(pip list *)"
    ],
    "ask": [
      "Edit",
      "Write",
      "Bash(pip install *)",
      "Bash(conda install *)",
      "Bash(uv pip install *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(bash *)",
      "Bash(sh *)",
      "Bash(chmod *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/credentials*)",
      "Bash(rm -rf *)",
      "Bash(sudo rm *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fdx *)",
      "Bash(curl * | sh)",
      "Bash(wget * | sh)"
    ]
  }
}